# Gemini API Configuration (Conversation Mode)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Microsoft Clarity Analytics (optional — omit to disable Clarity tracking)
VITE_CLARITY_PROJECT_ID=your-clarity-project-id-here

# Push notifications for errors (ntfy.sh - free, no signup)
# Install ntfy app on your phone, subscribe to this topic name
NTFY_TOPIC=your-unique-topic-name
