# App runtime configuration (pushed to Vercel by setup script)
# Copy this to .env.local and fill in real values

# Gemini API (required for AI conversation mode)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Auto-discovered flash models (populated by weekly cron job)
# GEMINI_FLASH_MODELS=gemini-3.5-flash,gemini-2.5-flash,...

# Microsoft Clarity Analytics (optional)
VITE_CLARITY_PROJECT_ID=your-clarity-project-id-here

# Push notifications for errors (ntfy.sh)
NTFY_TOPIC=your-unique-topic-name

# Cron job authentication (generate with: openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here

# Vercel API (for cron job to update env vars)
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_API_TOKEN=your-vercel-api-token
