# Deployment configuration (local scripts only, never pushed to Vercel)
# Copy this to .env.deploy and fill in your token
#
# IMPORTANT: You need a Vercel API Bearer token, NOT an OIDC/JWT token.
# JWT tokens (starting with "eyJ") only work inside Vercel CI/CD.
#
# To get your token:
#   1. Go to https://vercel.com/account/tokens
#   2. Click "Create"
#   3. Name it (e.g., "local-env-sync")
#   4. Set scope to "Full Account"
#   5. Copy the token and paste below (no quotes needed)

VERCEL_API_TOKEN=your-vercel-api-token-here
